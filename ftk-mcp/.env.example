HOST=0.0.0.0
PORT=8000
FTK_TIMEOUT_SECONDS=25
FTK_CRAWL_DELAY_SECONDS=3
FTK_MAX_RESPONSE_BYTES=6000000
FTK_SITE_SEARCH=true
FTK_CACHE_PATH=/tmp/ftk-mcp/products.sqlite3
# Recommended: identify your integration and add a contact address.
FTK_USER_AGENT=ftk-mcp/0.1 (+https://github.com/pulp-dev/AI-Assistant-for-news/tree/main/ftk-mcp; contact: you@example.com)

# For a non-Render deployment, add your public MCP hostname/origin:
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
